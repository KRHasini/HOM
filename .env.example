# =============================================================================
# House of Movements — environment variables
# Copy to `.env` at the repository root. Web (Next.js), API (FastAPI) and
# docker compose all read this one file. Never commit real secrets.
# =============================================================================

# ----------------------------------------------------------------- web (public)
# Canonical site URL — used for SEO canonicals, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the browser reaches the API (lead forms).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional prefix for media URLs (e.g. a CDN later). Empty = serve from /public.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Google Analytics 4 measurement id (G-XXXXXXX). Empty = analytics fully off.
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile (optional). Must match TURNSTILE_ENABLED below.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------- web (server-side)
# local = typed files in apps/web/src/content (default). api = overlay API data.
CONTENT_SOURCE=local
# How the Next.js server reaches the API (inside docker: http://api:8000).
API_INTERNAL_URL=http://localhost:8000

# ------------------------------------------------------------------------- api
# development | test | production  (production hides /docs, enables HSTS etc.)
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON logs (true) or pretty console logs (false) for local work.
LOG_JSON=false

# Postgres (asyncpg driver). docker compose overrides the host to `postgres`.
DATABASE_URL=postgresql+asyncpg://hom:hom@localhost:5432/hom
POSTGRES_USER=hom
POSTGRES_PASSWORD=hom
POSTGRES_DB=hom

# Comma-separated list of allowed browser origins (CORS).
WEB_ORIGINS=http://localhost:3000
# Trust X-Forwarded-For (set true only behind your own reverse proxy, e.g. Caddy).
TRUST_PROXY_HEADERS=false

# Secrets — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
IP_HASH_SECRET=change-me-ip-hash-secret
FORM_TOKEN_SECRET=change-me-form-token-secret

# Anti-spam
FORM_MIN_SECONDS=2
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW_SECONDS=600
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Notifications: console (logs only, default) | smtp
MAIL_BACKEND=console
MAIL_FROM="House of Movements <no-reply@houseofmovements.in>"
# Where new trial/contact leads are emailed. TODO(confirm)
STUDIO_NOTIFY_EMAIL=hello@houseofmovements.in
SEND_VISITOR_CONFIRMATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

STUDIO_NAME="House of Movements"
STUDIO_WHATSAPP=919742508862

# Media storage (Phase 2 uploads). Local directory today; cloud adapter later.
MEDIA_ROOT=var/media
MEDIA_BASE_URL=/media

# Re-run the idempotent content seed on API start (docker).
AUTO_SEED=true

# Observability (optional): Sentry DSN enables error reporting on the API.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ------------------------------------------------------------ production only
# Public domain served by Caddy (automatic HTTPS) in docker-compose.prod.yml.
DOMAIN=houseofmovements.in
ACME_EMAIL=hello@houseofmovements.in
# Nightly backup retention (days).
BACKUP_RETENTION_DAYS=14
